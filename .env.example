# CYBERSPLOI Environment Configuration
# Development, Staging, and Production settings

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersploi
DB_USER=cybersploi
DB_PASSWORD=cybersploi_dev_pass_123
DATABASE_URL=postgresql://cybersploi:cybersploi_dev_pass_123@localhost:5432/cybersploi

# Connection pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CONFIGURATION (Caching & Queues)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Cache settings
CACHE_TTL=3600
SESSION_TTL=86400

# ============================================================================
# API CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# API Keys and Secrets
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000
REACT_APP_ENV=development
REACT_APP_VERSION=1.0.0

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_FILE=/path/to/cert.pem
SSL_KEY_FILE=/path/to/key.pem

# Password Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE_DAYS=90

# Session Security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT_MINUTES=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/cybersploi/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Database logging
DB_LOG_LEVEL=WARNING
DB_ECHO_POOL=false

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY_ID=
S3_BUCKET=cybersploi-reports

# SendGrid Email Service
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@cybersploi.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Core Features
FEATURE_PENTESTING=true
FEATURE_VULNERABILITY_SCAN=true
FEATURE_MALWARE_ANALYSIS=true
FEATURE_BLUE_TEAM_DEFENSE=true
FEATURE_THREAT_INTELLIGENCE=true

# Advanced Features
FEATURE_RED_TEAM_SIMULATION=false
FEATURE_AUTOMATED_RESPONSE=false
FEATURE_AI_LEARNING=false

# UI Features
FEATURE_DASHBOARD=true
FEATURE_REPORTS=true
FEATURE_PEN_HUB=false

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================

# Background Tasks
BACKGROUND_TASK_TIMEOUT=3600
SCAN_TIMEOUT=600
ANALYSIS_TIMEOUT=900

# Caching
ENABLE_CACHING=true
CACHE_BACKEND=redis

# Batch Processing
BATCH_SIZE=100
BATCH_TIMEOUT=300

# ============================================================================
# COMPLIANCE & SECURITY
# ============================================================================

# Data Retention
DATA_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90
SCAN_HISTORY_RETENTION_DAYS=90

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY=change-this-key-in-production

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001
METRICS_NAMESPACE=cybersploi
METRICS_SUBSYSTEM=api

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# MALWARE ANALYSIS
# ============================================================================

# Sandbox Configuration
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY_MB=2048
SANDBOX_CPU_CORES=2

# Threat Intelligence Sources
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
SHODAN_API_KEY=

# ============================================================================
# SCAN CONFIGURATION
# ============================================================================

# Scan Defaults
DEFAULT_SCAN_TIMEOUT=600
DEFAULT_SCAN_CONCURRENCY=10
DEFAULT_SCAN_PAYLOAD_LIMIT=500

# Payload Configuration
PAYLOADS_DATABASE_PATH=/app/ai-engine/pentesting_payloads_7500.json
PAYLOADS_CACHE_ENABLED=true
PAYLOADS_CACHE_TTL=86400

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

DEBUG=false
TESTING=false
DEVELOPMENT=true

# Auto-reload on file changes
AUTO_RELOAD=true
RELOAD_DIRS=["backend", "frontend"]

# ============================================================================
# KUBERNETES CONFIGURATION
# ============================================================================

# Only used when running in Kubernetes
KUBERNETES_ENABLED=false
POD_NAME=cybersploi-api
POD_NAMESPACE=default
POD_IP=127.0.0.1

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

DOCKER_NETWORK=cybersploi-network
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=cybersploi

